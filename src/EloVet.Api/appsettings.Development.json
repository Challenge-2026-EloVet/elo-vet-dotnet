{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] App={Application} Env={Environment} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "elo-vet"
  },
  "Jwt": {
    "Key": "development-only-key-do-not-use-in-production-32-chars",
    "Issuer": "EloVet.Api",
    "Audience": "EloVet.Client",
    "ExpirationInMinutes": 120
  }
}
